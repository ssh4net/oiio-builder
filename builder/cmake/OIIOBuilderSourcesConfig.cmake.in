# Generated by oiio-builder. These are host-local source checkout paths.
# Loading this package does not add targets, compile sources, or change cache options.

# A second find_package() may select a different prefix. Clear the previous map.
foreach(_oiio_source IN LISTS OIIOBuilderSources_REPOSITORIES)
  unset("OIIOBuilderSources_SOURCE_DIR_${_oiio_source}")
  unset("OIIOBuilderSources_${_oiio_source}_FOUND")
endforeach()
@SOURCE_ASSIGNMENTS@

set(OIIOBuilderSources_FOUND TRUE)
set(OIIOBuilderSources_NOT_FOUND_MESSAGE "")
set(OIIOBuilderSources_AVAILABLE_REPOSITORIES "")
foreach(_oiio_source IN LISTS OIIOBuilderSources_REPOSITORIES)
  if(IS_DIRECTORY "${OIIOBuilderSources_SOURCE_DIR_${_oiio_source}}")
    set("OIIOBuilderSources_${_oiio_source}_FOUND" TRUE)
    list(APPEND OIIOBuilderSources_AVAILABLE_REPOSITORIES "${_oiio_source}")
  else()
    set("OIIOBuilderSources_${_oiio_source}_FOUND" FALSE)
  endif()
endforeach()
foreach(_oiio_source IN LISTS OIIOBuilderSources_FIND_COMPONENTS)
  list(FIND OIIOBuilderSources_AVAILABLE_REPOSITORIES "${_oiio_source}" _oiio_source_index)
  if(_oiio_source_index EQUAL -1)
    set("OIIOBuilderSources_${_oiio_source}_FOUND" FALSE)
    if(OIIOBuilderSources_FIND_REQUIRED_${_oiio_source})
      set(OIIOBuilderSources_FOUND FALSE)
      string(APPEND OIIOBuilderSources_NOT_FOUND_MESSAGE
        "Source checkout '${_oiio_source}' is unregistered or no longer exists. Refresh with build.py --register-sources. ")
    endif()
  endif()
endforeach()

function(oiio_builder_source_dir repository output_variable)
  if(NOT ARGC EQUAL 2)
    message(FATAL_ERROR "Usage: oiio_builder_source_dir(<repository> <output_variable>)")
  endif()
  set(_oiio_variable "OIIOBuilderSources_SOURCE_DIR_${repository}")
  list(FIND OIIOBuilderSources_REPOSITORIES "${repository}" _oiio_index)
  if(_oiio_index EQUAL -1)
    message(FATAL_ERROR
      "No source checkout registered for '${repository}'. Refresh with build.py --register-sources.")
  endif()
  if(NOT IS_DIRECTORY "${${_oiio_variable}}")
    message(FATAL_ERROR
      "Source checkout '${repository}' no longer exists: ${${_oiio_variable}}. Refresh with build.py --register-sources.")
  endif()
  set("${output_variable}" "${${_oiio_variable}}" PARENT_SCOPE)
endfunction()

unset(_oiio_source)
unset(_oiio_source_index)
