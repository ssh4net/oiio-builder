include(GNUInstallDirs)
include(CMakePackageConfigHelpers)
find_package(Threads REQUIRED)

set(_geo_targets geogram)
set(_geo_dependencies Threads::Threads ${CMAKE_DL_LIBS})
if(WIN32)
  list(APPEND _geo_dependencies psapi)
  target_compile_definitions(geogram INTERFACE NOMINMAX _USE_MATH_DEFINES WIN32_LEAN_AND_MEAN VC_EXTRALEAN)
endif()
if((LINUX AND NOT GEOGRAM_WITH_EMSCRIPTEN) OR GEOGRAM_WITH_TBB)
  # Upstream uses TBB for GCC parallel STL even with its thread-manager option OFF.
  find_package(TBB CONFIG REQUIRED)
  list(APPEND _geo_dependencies TBB::tbb)
  get_target_property(_geo_build_links geogram LINK_LIBRARIES)
  if(NOT _geo_build_links)
    set(_geo_build_links "")
  endif()
  list(REMOVE_ITEM _geo_build_links tbb)
  list(APPEND _geo_build_links TBB::tbb)
  set_property(TARGET geogram PROPERTY LINK_LIBRARIES "${_geo_build_links}")
endif()
set_property(TARGET geogram APPEND PROPERTY LINK_LIBRARIES Threads::Threads ${CMAKE_DL_LIBS})
set_property(TARGET geogram PROPERTY INTERFACE_LINK_LIBRARIES "${_geo_dependencies}")
set_property(TARGET geogram PROPERTY INTERFACE_INCLUDE_DIRECTORIES
  "$<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/src/lib>;$<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/${VORPALINE_INCLUDE_SUBPATH}>")
if(BUILD_SHARED_LIBS)
  target_compile_definitions(geogram INTERFACE GEO_DYNAMIC_LIBS)
endif()
if(GEOGRAM_WITH_GARGANTUA)
  target_compile_definitions(geogram INTERFACE GARGANTUA)
endif()

if(GEOGRAM_WITH_GRAPHICS)
  find_package(OpenGL REQUIRED)
  list(APPEND _geo_targets geogram_gfx)
  set(_geo_gfx_dependencies geogram glfw OpenGL::GL)
  if(UNIX AND NOT APPLE AND NOT EMSCRIPTEN)
    find_package(X11 REQUIRED)
    if(TARGET X11::X11)
      list(APPEND _geo_gfx_dependencies X11::X11)
    else()
      list(APPEND _geo_gfx_dependencies ${X11_LIBRARIES})
    endif()
  endif()
  set_property(TARGET geogram_gfx PROPERTY INTERFACE_LINK_LIBRARIES "${_geo_gfx_dependencies}")
  set_property(TARGET geogram_gfx PROPERTY INTERFACE_INCLUDE_DIRECTORIES
    "$<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/src/lib/geogram_gfx/third_party>;$<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/${VORPALINE_INCLUDE_SUBPATH}/geogram_gfx/third_party>")
endif()

install(TARGETS ${_geo_targets} EXPORT GeogramTargets
  ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
  LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
  RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
set(_geo_package_dir "${CMAKE_INSTALL_LIBDIR}/cmake/Geogram")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/GeogramConfig.cmake.in" [=[
@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if((UNIX AND NOT APPLE) OR @GEOGRAM_WITH_TBB@)
  find_dependency(TBB CONFIG)
endif()
if(@GEOGRAM_WITH_GRAPHICS@)
  find_dependency(glfw3 CONFIG)
  find_dependency(OpenGL)
  if(UNIX AND NOT APPLE)
    find_dependency(X11)
  endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/GeogramTargets.cmake")
check_required_components(Geogram)
]=])
configure_package_config_file("${CMAKE_CURRENT_BINARY_DIR}/GeogramConfig.cmake.in"
  "${CMAKE_CURRENT_BINARY_DIR}/GeogramConfig.cmake" INSTALL_DESTINATION "${_geo_package_dir}")
write_basic_package_version_file("${CMAKE_CURRENT_BINARY_DIR}/GeogramConfigVersion.cmake"
  VERSION "${PROJECT_VERSION}" COMPATIBILITY SameMajorVersion)
install(EXPORT GeogramTargets NAMESPACE Geogram:: DESTINATION "${_geo_package_dir}")
install(FILES "${CMAKE_CURRENT_BINARY_DIR}/GeogramConfig.cmake"
  "${CMAKE_CURRENT_BINARY_DIR}/GeogramConfigVersion.cmake" DESTINATION "${_geo_package_dir}")
unset(_geo_targets)
unset(_geo_dependencies)
unset(_geo_gfx_dependencies)
unset(_geo_build_links)
unset(_geo_package_dir)
