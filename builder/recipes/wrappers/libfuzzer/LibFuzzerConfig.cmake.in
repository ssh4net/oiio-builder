@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
set(LibFuzzer_VERSION "@PROJECT_VERSION@")
set(LibFuzzer_CXX_STDLIB "@LibFuzzer_CXX_STDLIB@")
set(LibFuzzer_CXX_COMPILER_ID "@CMAKE_CXX_COMPILER_ID@")
set(LibFuzzer_CXX_COMPILER_VERSION "@CMAKE_CXX_COMPILER_VERSION@")
if(LibFuzzer_CXX_STDLIB STREQUAL "libc++" AND NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang")
    set(LibFuzzer_FOUND FALSE)
    set(LibFuzzer_NOT_FOUND_MESSAGE "This libFuzzer package requires a Clang/libc++ C++ consumer")
    return()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/LibFuzzerTargets.cmake")
check_required_components(LibFuzzer)
